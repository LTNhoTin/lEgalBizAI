# Embedding Model Specific - Ignore outputs, checkpoints, but allow source code
finetune/embedding_models/*/output/
finetune/embedding_models/*/models/
finetune/embedding_models/*/checkpoint*/
finetune/embedding_models/*/checkpoints/
finetune/embedding_models/*/wandb/
finetune/embedding_models/all_minilm_l6_v2/output/
finetune/embedding_models/baai_bge_m3/models/
finetune/embedding_models/google_gemma_embeddings/output/

# But allow source code and config files in embedding_models
!finetune/embedding_models/**/*.py
!finetune/embedding_models/**/*.yaml
!finetune/embedding_models/**/*.yml
!finetune/embedding_models/**/*.ipynb
!finetune/embedding_models/**/*.md
!finetune/embedding_models/**/*.txt
