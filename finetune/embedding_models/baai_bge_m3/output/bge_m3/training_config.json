{
  "model_name": "BAAI/bge-m3",
  "max_seq_length": 384,
  "batch_size": 2,
  "num_epochs": 6,
  "learning_rate": 1e-05,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "gradient_accumulation_steps": 2,
  "max_grad_norm": 1.0,
  "use_lora": true,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "use_dense": true,
  "use_sparse": false,
  "use_colbert": false,
  "use_fp16": true,
  "use_bf16": false,
  "logging_steps": 100,
  "eval_steps": 1000,
  "save_steps": 1000,
  "output_dir": "./output/bge_m3",
  "use_wandb": true,
  "wandb_project": "legal-embedding-models",
  "wandb_run_name": "bge-m3-optimized"
}